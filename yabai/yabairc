#!/usr/bin/env sh

# =============================================================
# yabai config  (Hyprland-like tiling / SIP 有効・scripting addition なし)
# =============================================================

# --- レイアウト --------------------------------------------------
yabai -m config layout                      bsp   # 二分木タイル(Hyprland の dwindle 相当)
yabai -m config auto_balance                off   # 手動リサイズを尊重
yabai -m config split_ratio                 0.50  # 分割時の初期比率
yabai -m config window_placement            second_child

# --- ギャップ / 余白 --------------------------------------------
yabai -m config window_gap                  0
yabai -m config top_padding                 0
yabai -m config bottom_padding              0
yabai -m config left_padding                0
yabai -m config right_padding               0

# --- マウス操作 --------------------------------------------------
# フォーカスはマウス追従、focus は autoraise
yabai -m config mouse_follows_focus         off
yabai -m config focus_follows_mouse         autofocus

# alt を押しながらドラッグで 移動 / リサイズ (Hyprland の SUPER+drag 相当)
yabai -m config mouse_modifier              alt
yabai -m config mouse_action1               move    # 左ドラッグ = 移動
yabai -m config mouse_action2               resize  # 右ドラッグ = リサイズ
yabai -m config mouse_drop_action           swap

# --- ウィンドウ枠(不透明度) ------------------------------------
# scripting addition なしでも動く範囲のみ設定
yabai -m config window_opacity              off
yabai -m config window_shadow               on

# --- フロートさせるアプリ (タイル対象外) -------------------------
yabai -m rule --add app="^システム設定$"        manage=off
yabai -m rule --add app="^System Settings$"     manage=off
yabai -m rule --add app="^ファインダ$"          title="^(コピー|情報|環境設定)"   manage=off
yabai -m rule --add app="^Finder$"              title="^(Copy|Info|Preferences)"   manage=off
yabai -m rule --add app="^電卓$"               manage=off
yabai -m rule --add app="^Calculator$"          manage=off
yabai -m rule --add app="^アクティビティモニタ$" manage=off
yabai -m rule --add app="^Activity Monitor$"    manage=off
yabai -m rule --add app="^App Store$"           manage=off
yabai -m rule --add app="^Karabiner-Elements$"  manage=off

echo "yabai configuration loaded.."
